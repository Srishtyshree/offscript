# Copy to api/.env for local development. Never commit .env.
# Leave keys blank until you have real ones: /health reports model_configured=false while they are blank.

# development | production
OFFSCRIPT_ENV=development
# live = real Tinker checkpoint; mock = local-only fake router, labelled MOCK in the UI. Never mock in production.
OFFSCRIPT_MODE=live

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Tinker (verify exact names against the Tinker SDK). Model path looks like tinker://...
TINKER_API_KEY=
TINKER_MODEL_PATH=

# SerpApi
SERPAPI_API_KEY=
